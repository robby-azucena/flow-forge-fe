{
  "folders": [
    {
      "path": ".",
    },
  ],
  "settings": {},
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Run server",
        "type": "node-terminal",
        "request": "launch",
        "command": "npm run dev",
      },
      {
        "name": "Debug with Firefox",
        "type": "firefox",
        "request": "launch",
        "reAttach": true,
        "url": "http://localhost:3000",
        "pathMappings": [
          {
            "url": "webpack://_n_e",
            "path": "${workspaceFolder}",
          },
        ],
      },
      {
        "name": "Debug with Chrome",
        "type": "node-terminal",
        "request": "launch",
        "command": "npm run dev",
        "serverReadyAction": {
          "pattern": "- Local:.+(https?://.+)",
          "uriFormat": "%s",
          "action": "debugWithChrome",
        },
      },
    ],
    "compounds": [
      {
        "name": "Server + Firefox",
        "configurations": ["Run server", "Debug with Firefox"],
        "stopAll": true,
      },
    ],
  },
}
